# ── Database ──────────────────────────────────────────────
DB_NAME=tamagotchi
DB_USER=tamagotchi_user
DB_PASSWORD=CHANGE_ME_strong_password
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password

# ── GitHub OAuth ──────────────────────────────────────────
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=https://your-domain.com/oauth/github/callback

# ── Webhook ───────────────────────────────────────────────
WEBHOOK_SECRET=your_webhook_secret
WEBHOOK_CALLBACK_URL=https://your-domain.com/github/webhook

# ── JWT ───────────────────────────────────────────────────
# Must be at least 32 characters for HS256
JWT_SECRET=CHANGE_ME_a_random_64_char_string_here_use_openssl_rand

# ── Spring ────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod
